{
  "name": "fruit-price-tracker",
  "version": "1.0.0",
  "description": "每日水果成本记账与价格对比独立App (支持Android/iOS打包与云端同步)",
  "main": "www/index.html",
  "scripts": {
    "start": "npx serve www -l 8080",
    "cap:init": "npx cap init 水果成本记账 com.fruitprice.tracker --web-dir www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "keywords": [
    "fruit",
    "cost-tracker",
    "capacitor",
    "android",
    "mobile-app"
  ],
  "license": "MIT"
}
